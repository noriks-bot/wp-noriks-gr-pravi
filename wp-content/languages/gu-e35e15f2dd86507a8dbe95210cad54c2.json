aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82."],"Plugin for %s installed and activated successfully.":["%s \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a85\u0aa8\u0ac7 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0aa5\u0aaf\u0ac1\u0a82."],"If the connector you need is not listed, <a>search the plugin directory<\/a> to see if a connector is available.":["\u0a9c\u0acb \u0aa4\u0aae\u0aa8\u0ac7 \u0a9c\u0acb\u0a88\u0aa4\u0acb \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f\u0ab0 \u0ab8\u0ac2\u0a9a\u0abf\u0aac\u0aa6\u0acd\u0aa7 \u0aa8 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f\u0ab0 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a95\u0ac7\u0aae \u0aa4\u0ac7 \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 <a>\u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0aa1\u0abf\u0ab0\u0ac7\u0a95\u0acd\u0a9f\u0ab0\u0ac0 \u0ab6\u0acb\u0aa7\u0acb<\/a>."],"Connectors appear here when you install plugins that use external services. Each plugin registers the API keys it needs, and you manage them all in one place.":["\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0ac7 \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8\u0acd\u0ab8 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0acb \u0a9b\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f\u0ab0\u0acd\u0ab8 \u0a85\u0ab9\u0ac0\u0a82 \u0aa6\u0ac7\u0a96\u0abe\u0aaf \u0a9b\u0ac7. \u0aa6\u0ab0\u0ac7\u0a95 \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 API \u0a95\u0ac0 \u0ab0\u0a9c\u0ac0\u0ab8\u0acd\u0a9f\u0ab0 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0ac7 \u0aac\u0aa7\u0abe\u0aa8\u0ac7 \u0a8f\u0a95 \u0a9c \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a8f \u0aae\u0ac7\u0aa8\u0ac7\u0a9c \u0a95\u0ab0\u0acb \u0a9b\u0acb."],"No connectors yet":["\u0ab9\u0a9c\u0ac0 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a95\u0acb\u0a88 \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f\u0ab0\u0acd\u0ab8 \u0aa8\u0aa5\u0ac0"],"All of your API keys and credentials are stored here and shared across plugins. Configure once and use everywhere.":["\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aac\u0aa7\u0ac0 API \u0a95\u0ac0 \u0a85\u0aa8\u0ac7 \u0a93\u0ab3\u0a96\u0aaa\u0aa4\u0acd\u0ab0\u0acb \u0a85\u0ab9\u0ac0\u0a82 \u0ab8\u0a82\u0a97\u0acd\u0ab0\u0ab9\u0abf\u0aa4 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8\u0acd\u0ab8 \u0aaa\u0ab0 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0a97\u0acb\u0aa0\u0ab5\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ab0\u0ac7\u0a95 \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a8f \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acb."],"Control features in the AI plugin":["AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3 \u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe\u0a93"],"Activate the AI plugin":["AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a95\u0ab0\u0acb"],"Install the AI plugin":["AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0acb"],"The <strong>AI plugin<\/strong> is ready to use. You can use it to generate featured images, alt text, titles, excerpts and more. <a>Learn more<\/a>":["<strong>AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8<\/strong> \u0ab5\u0abe\u0aaa\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0ac8\u0aaf\u0abe\u0ab0 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aab\u0ac0\u0a9a\u0ab0\u0acd\u0aa1 \u0a9b\u0aac\u0ac0\u0a93, \u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95 \u0a9f\u0ac7\u0a95\u0acd\u0ab8\u0acd\u0a9f, \u0ab6\u0ac0\u0ab0\u0acd\u0ab7\u0a95\u0acb, \u0a85\u0ab5\u0aa4\u0ab0\u0aa3\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. <a>\u0ab5\u0aa7\u0ac1 \u0a9c\u0abe\u0aa3\u0acb<\/a>"],"Failed to activate the AI plugin.":["AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0abf\u0ab7\u0acd\u0aab\u0ab3."],"The <strong>AI plugin<\/strong> is installed. Connect an AI provider below to generate featured images, alt text, titles, excerpts, and more. <a>Learn more<\/a>":["<strong>AI \u0aaa\u0acd\u0ab2\u0a97\u0a87\u0aa8<\/strong> \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0ac7\u0ab2\u0ac1\u0a82 \u0a9b\u0ac7. \u0aab\u0ac0\u0a9a\u0ab0\u0acd\u0aa1 \u0a9b\u0aac\u0ac0\u0a93, \u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95 \u0a9f\u0ac7\u0a95\u0acd\u0ab8\u0acd\u0a9f, \u0ab6\u0ac0\u0ab0\u0acd\u0ab7\u0a95\u0acb, \u0a85\u0ab5\u0aa4\u0ab0\u0aa3\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1 \u0a9c\u0aa8\u0ab0\u0ac7\u0a9f \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7 \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa4\u0abe\u0aa8\u0ac7 \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f \u0a95\u0ab0\u0acb. <a>\u0ab5\u0aa7\u0ac1 \u0a9c\u0abe\u0aa3\u0acb<\/a>"],"Connectors":["\u0a9c\u0acb\u0aa1\u0abe\u0aa3\u0acb"],"Activating\u2026":["\u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7..."],"Installing\u2026":["\u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0aaa\u0acd\u0ab0\u0a95\u0acd\u0ab0\u0abf\u0aaf\u0abe \u0a9a\u0abe\u0ab2\u0ac1"],"Learn more":["\u0ab5\u0aa7\u0ac1 \u0ab6\u0ac0\u0a96\u0acb"],"Edit":["\u0ab8\u0a82\u0aaa\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0acb"],"Can